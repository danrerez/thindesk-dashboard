{
  "info": {
    "name": "Thindesk Dashboard API",
    "description": "API do dashboard administrativo de chamados (Thindesk). Configure as variáveis baseUrl, email e password (usuário MANAGER ou ADMIN). Rode a pasta 'Ciclo de vida do chamado' em ordem: ela cria um chamado e o leva até Fechado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{email}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "email",
      "value": "${YOUR_EMAIL}"
    },
    {
      "key": "password",
      "value": "${YOUR_PASSWORD}"
    },
    {
      "key": "from",
      "value": "2026-10-11"
    },
    {
      "key": "to",
      "value": "2026-11-09"
    },
    {
      "key": "ticketId",
      "value": ""
    },
    {
      "key": "technicianId",
      "value": ""
    }
  ],
