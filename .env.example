# Copie este arquivo para ".env" (mesma pasta) e troque cada ${YOUR_...} pelo seu valor.
# O arquivo .env está no .gitignore e NUNCA deve ser versionado.

# String de conexão do MongoDB Atlas (Database > Connect > Drivers > Java), no formato:
# mongodb+srv://<usuario>:<senha>@<cluster>.xxxxx.mongodb.net/?retryWrites=true&w=majority&tls=true&appName=<cluster>
# O protocolo mongodb+srv:// já habilita TLS; o parâmetro tls=true deixa isso explícito.
MONGODB_URI=${YOUR_MONGODB_URI}
MONGODB_DATABASE=thindesk

# Administrador criado automaticamente no primeiro start (se ainda não existir).
# A senha precisa ter 8+ caracteres, com maiúscula, minúscula, número e símbolo.
ADMIN_NAME=${YOUR_NAME}
ADMIN_EMAIL=${YOUR_EMAIL}
ADMIN_PASSWORD=${YOUR_PASSWORD}

# Tema visual (pasta em src/main/resources/static/themes): default | dark
APP_THEME=default

# Use true em produção (HTTPS) para o cookie de sessão só trafegar criptografado.
COOKIE_SECURE=false

# Desative o cache do Thymeleaf durante o desenvolvimento para ver alterações sem reiniciar.
THYMELEAF_CACHE=false

# Dashboard: fuso usado nos filtros/gráficos e intervalo da atualização automática (segundos).
APP_TIMEZONE=America/Sao_Paulo
DASHBOARD_REFRESH_SECONDS=60

# Massa de demonstração: gera chamados quando a coleção está vazia.
# SEED_RESET=true apaga chamados e técnicos e gera de novo (use uma vez e volte para false).
SEED_ENABLED=true
SEED_RESET=false
SEED_TICKETS=1400
SEED_DAYS=180
